{
  "name": "@resumiq/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS backend — auth, career profile, AI-powered onboarding ingest.",
  "scripts": {
    "build": "nest build",
    "dev": "nodemon",
    "start": "node dist/main",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "scan:jobs": "ts-node --transpile-only scripts/scan-and-ingest.ts",
    "verify:ingest": "ts-node --transpile-only scripts/verify-ingest-survival.ts",
    "eval:fixtures": "ts-node --transpile-only eval/build-fixtures.ts",
    "eval:run": "ts-node --transpile-only eval/run-eval.ts",
    "eval:labels": "ts-node --transpile-only eval/calibration.ts",
    "eval:report": "ts-node --transpile-only eval/report.ts",
    "eval:sanity": "ts-node --transpile-only eval/sanity-check.ts",
    "eval:test": "jest -c eval/jest.config.js",
    "eval:type-check": "tsc --noEmit -p eval/tsconfig.json"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "^5.22.0",
    "@resumiq/ai-bridge": "*",
    "@resumiq/job-scanner": "*",
    "@resumiq/resume-renderer": "*",
    "@resumiq/schemas": "*",
    "better-auth": "^1.2.9",
    "bullmq": "^6.3.2",
    "dotenv": "^16.4.0",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.0"
  }
}
