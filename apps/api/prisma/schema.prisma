generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── better-auth required tables ─────────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  role          String    @default("user")
  settings      Json      @default("{}")
  sessions      Session[]
  accounts      Account[]

  careerProfile CareerProfile?
  applications  Application[]
  matchPreviews JobMatchPreview[]
  dismissedJobs DismissedJob[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("accounts")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verifications")
}

// ── Phase 1: Career Inventory ───────────────────────────────────────────────

model CareerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // MasterDB sections stored as JSONB for schema flexibility
  personalInfo              Json @default("{}")
  summaries                 Json @default("[]")
  experience                Json @default("[]")
  education                 Json @default("[]")
  projects                  Json @default("[]")
  skills                    Json @default("{}")
  certifications            Json @default("[]")
  awardsAndHonors           Json @default("[]")
  publicationsAndSpeaking   Json @default("[]")
  volunteeringAndLeadership Json @default("[]")
  interests                 Json @default("[]")

  // Computed strength score (0-100), refreshed on each update
  strengthScore Int @default(0)

  @@map("career_profiles")
}

// ── Phase 2: Manual Job Application Flow ────────────────────────────────────

model Job {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  source      String  @default("manual") // 'manual' | 'scraper'
  sourceUrl   String?
  title       String
  companyName String
  companyInfo Json? // values, tone, culture signals, tech stack
  rawJd       String  @db.Text
  parsedJd    Json? // { required_skills[], nice_to_have[], seniority, keywords[] } — JobDNA
  location    String?
  remote      Boolean @default(false)
  salaryRange String?

  // Normalized `slugify(companyName)|slugify(title)|slugify(location ?? '')`,
  // computed in TS at ingestion time (see jobs.service.ts). Replaces a raw
  // (companyName, title, location) composite unique, which breaks on NULL
  // locations (Postgres treats each NULL as distinct) and casing/whitespace
  // drift across scrape runs.
  dedupeKey String @unique

  applications  Application[]
  matchPreviews JobMatchPreview[]
  dismissedBy   DismissedJob[]

  @@map("jobs")
}

model Application {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  matchScore   Int
  matchReasons Json // string[] — explainability reasons from checkCompatibility()
  status       String @default("gap_reported") // 'gap_reported' | 'resume_drafted' | 'email_drafted' | 'ready' | 'archived'

  gapReport       Json? // GapReport-shaped, null once matched
  resumeSelection Json? // editable AISelection draft — the review-gate field
  resumeSource    String? @db.Text // .tex or .typ source
  renderedWith    String? // 'latex' | 'typst'
  resumePdfPath   String?
  emailDraft      Json? // { subject, body }
  interviewPrep   Json? // { intake: { weak_topics, questions, answers? }, report: InterviewPrepReport | null }

  @@index([userId])
  @@map("applications")
}

// ── Phase 3: Job Discovery (Swipe Feed) ─────────────────────────────────────

model JobMatchPreview {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  matchScore Int
  computedAt DateTime @default(now())

  @@unique([userId, jobId])
  @@index([userId, matchScore])
  @@map("job_match_previews")
}

model DismissedJob {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  dismissedAt DateTime @default(now())

  @@id([userId, jobId])
  @@map("dismissed_jobs")
}

