# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/resumiq"

# App URLs
API_URL="http://localhost:3001"
TRUSTED_ORIGINS="http://localhost:3000"

# Auth — GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Auth — LinkedIn OAuth
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# LLM — freellmapi (default provider)
FREELLMAPI_BASE_URL="https://freellmapi-19vj.onrender.com/v1"
