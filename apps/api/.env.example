# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/resumiq"

# App URLs
API_URL="http://localhost:3001"
TRUSTED_ORIGINS="http://localhost:3000"

# Auth — GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Auth — LinkedIn OAuth
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# LLM — Bridge (claude-web-bridge)
BRIDGE_URL="http://127.0.0.1:3000"
LLM_PREFERRED="claude"
LLM_FALLBACK="chatgpt"

# LLM — Gemini (free tier, 15 RPM; add multiple keys for more throughput)
GEMINI_MODEL="gemini-2.5-flash-lite"
GEMINI_API_KEY_1=""
# GEMINI_API_KEY_2=""

# LLM — Groq (multiple keys for rate-limit rotation)
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_API_KEY_1=""
# GROQ_API_KEY_2=""

# LLM — Ollama (local fallback)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2"

# Port
PORT=3001
