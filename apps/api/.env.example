# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/resumiq"

# Queue — BullMQ, backed by Upstash Redis. Must be the TCP/TLS connection
# string (rediss://...), NOT the Upstash REST API URL.
REDIS_URL="rediss://default:password@your-db.upstash.io:6379"

# App URLs
API_URL="http://localhost:3001"
TRUSTED_ORIGINS="http://localhost:3000"

# Auth — better-auth
BETTER_AUTH_SECRET=""

# Auth — dev seed script overrides (apps/api/prisma/seed.ts)
# SEED_USER_EMAIL=dev@resumiq.local
# SEED_USER_PASSWORD=devpass123

# Auth — GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Auth — LinkedIn OAuth
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# LLM — freellmapi (default provider)
# FREELLMAPI_MODEL is pinned rather than left as "auto" — auto-routing can
# land on agentic "compound" or reasoning models that stream zero bytes for
# 45s+ before answering, which reads as a hung request to the client's SSE
# idle timeout. gemini-3.5-flash-lite is a fast, non-reasoning instruct
# model well suited to structured JSON extraction.
FREELLMAPI_BASE_URL="https://freellmapi-19vj.onrender.com/v1"
FREELLMAPI_API_KEY=""
FREELLMAPI_MODEL="gemini-3.5-flash-lite"

# LLM — Bridge (claude-web-bridge) — only used when USE_LLM_BRIDGE=true
USE_LLM_BRIDGE="false"
BRIDGE_URL="http://127.0.0.1:3000"
BRIDGE_PROVIDER="claude"

# Port
PORT=3001

# Resume render engine — 'latex' (tectonic) or 'typst'. Both shell out to a
# local CLI binary; see apps/api/Dockerfile for how they're installed in prod.
RESUME_RENDER_ENGINE="latex"

# Enrichment — Hunter.io (recruiter/contact email) and People Data Labs
# (company profile). Both have free tiers, no credit card required. Optional:
# ingestion runs fine without them, enrichment fields just stay null.
HUNTER_API_KEY=""
PDL_API_KEY=""
