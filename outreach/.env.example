# Copy to .env (gitignored). Names only; never commit values.

# Postgres connection string. The `schema=outreach` parameter is required: it keeps
# these tables and their _prisma_migrations out of the `public` schema.
OUTREACH_DATABASE_URL=

# Optional: path to the tectonic binary. Default: `tectonic` on PATH
# (Windows install used here: C:\Tools\Tectonic\tectonic.exe).
TECTONIC_PATH=

# Optional: config file, relative to this folder. Default: outreach.config.json
OUTREACH_CONFIG_PATH=

# Gmail sending (auth, signature, tick). OAuth client of type "Desktop app" from your own
# Google Cloud project, with the Gmail API enabled.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Optional: where the refresh token is saved (must be outside this repo).
# Default: %USERPROFILE%\.config\cold-outreach\gmail-token.json
GMAIL_TOKEN_PATH=

# Optional: Hunter.io API key. When set, `npm run outreach -- hunter <domain> --run <id>` looks up
# published contact addresses for a domain during sourcing. Unset: the command does nothing.
HUNTER_API_KEY=
