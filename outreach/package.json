{
  "name": "cold-outreach-job-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Cold-outreach agent for part-time jobs and internships: Claude Code does the research and writing, small tested scripts do everything else (ingest, quote verification, critic, resume render, DB).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "outreach": "ts-node --transpile-only src/cli/index.ts",
    "outreach:review": "ts-node --transpile-only src/cli/index.ts review",
    "outreach:auth": "ts-node --transpile-only src/cli/index.ts auth",
    "outreach:signature": "ts-node --transpile-only src/cli/index.ts signature",
    "outreach:tick": "ts-node --transpile-only src/cli/index.ts tick",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.0",
    "google-auth-library": "^10.9.1",
    "ink": "^6.8.0",
    "luxon": "^3.5.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.4",
    "undici": "^7.29.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
