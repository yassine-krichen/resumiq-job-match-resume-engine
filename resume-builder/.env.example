# LLM provider: groq | ollama
LLM_PROVIDER=groq

# Groq API key — get free at console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Model to use
# Groq options:  llama-3.3-70b-versatile | mixtral-8x7b-32768 | gemma2-9b-it
# Ollama options: llama3.2 | mistral | phi4 (must be pulled locally)
LLM_MODEL=llama-3.3-70b-versatile

# Ollama base URL (only used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
