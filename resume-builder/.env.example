# ── Bridge (claude-web-bridge) ───────────────────────────────────────────────
# URL where claude-web-bridge is running (default matches bridge's PORT=3000)
BRIDGE_URL=http://127.0.0.1:3000

# Which bridge provider to try first, and which to fall back to.
# Options: claude | chatgpt | none
LLM_PREFERRED=claude
LLM_FALLBACK=chatgpt

# ── Gemini / Google AI Studio (1st API fallback — better context + JSON than Groq) ──
# Get free keys at: https://aistudio.google.com/apikey
GEMINI_API_KEY_1=AIza...
# GEMINI_API_KEY_2=AIza...
# GEMINI_API_KEY_3=AIza...
# GEMINI_API_KEY_4=AIza...
# GEMINI_API_KEY_5=AIza...

# Model used for all Gemini calls.
GEMINI_MODEL=gemini-2.5-flash

# ── Groq (2nd API fallback) ───────────────────────────────────────────────────
# Add as many keys as you have. Keys are tried in order (1, 2, 3...).
# On rate limit or auth failure, the next key is tried automatically.
# Get free keys at: https://console.groq.com
GROQ_API_KEY_1=gsk_...
# GROQ_API_KEY_2=gsk_...
# GROQ_API_KEY_3=gsk_...
# GROQ_API_KEY_4=gsk_...
# GROQ_API_KEY_5=gsk_...

# Model used for all Groq calls. Must be available on the free tier.
GROQ_MODEL=llama-3.3-70b-versatile

# ── Ollama (last resort — local model) ───────────────────────────────────────
# Requires Ollama running locally: https://ollama.ai
# Pull a model first: ollama pull llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# ── Editor (post-generate bullet review prompt) ──────────────────────────────
# Defaults to $EDITOR env var, then notepad (Windows) or vi (Unix).
# EDITOR=code
